# ==========================================
# VERA (Voice Emergency Response Assistant)
# Environment Variables Example
# ==========================================

# ------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------
# Find these in your Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------
# OMNIROUTE CONFIGURATION (Local Dev Router)
# ------------------------------------------
# Default local OmniRoute instance runs at port 20128
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key-if-configured
OMNIROUTE_MODEL=default-model

# ------------------------------------------
# BACKEND SERVER CONFIGURATION
# ------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------
# EXTERNAL FREE/OPEN APIS
# ------------------------------------------
# Primary translation service (LibreTranslate instance or local)
LIBRETRANSLATE_URL=https://libretranslate.com
# OpenStreetMap Geocoding & POI Search
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ------------------------------------------
# NOTIFICATION SERVICE (Resend Free Tier)
# ------------------------------------------
# Free tier: 100 emails/day at resend.com (Leave empty for local mock fallback)
EMAIL_SERVICE_API_KEY=
EMAIL_FROM_ADDRESS=VERA Emergency Dispatch <onboarding@resend.dev>

